; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Lost Memories"
run/main_scene="res://scenes/TelaInicial.tscn"
config/icon="res://assets/icons/LM_icon.png"

[autoload]

FpsAutoload="*res://scripts/fps_autoload.gd"
Inventory="*res://scripts/inventory.gd"
SaveManager="*res://scripts/SaveManager.gd"
InputManager="*res://scripts/InputManager.gd"
TutorialManager="*res://scripts/TutorialManager.gd"
Global="*res://scripts/global.gd"
Legendas="*res://scenes/Legendas.tscn"
CartasInventory="*res://scenes/CartasInventory.tscn"
QuartoLaura="*res://scripts/quarto_laura.gd"
CartasUI="*res://scenes/CartasUI.tscn"
RankingUI="*res://scripts/RankingUI.gd"
TelaPickup="*res://scenes/TelaPickup.tscn"

[display]

window/vsync/use_vsync=false
window/stretch/mode="2d"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

