# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" real para o GitHub.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=limbo_of_memories
DB_PORT=3306

JWT_SECRET=troque_isso_por_uma_string_bem_aleatoria_e_secreta

PORT=3000

# URL do site (link no e-mail de verificação)
FRONTEND_URL=https://limboofmemories.netlify.app

# E-mail (SMTP) — exemplos: Gmail, Resend, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM="Limbo of Memories <seu_email@gmail.com>"
